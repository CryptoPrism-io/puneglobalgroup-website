<%
  var isEdit = template !== null && template !== undefined;
  var action = isEdit ? '/templates/' + template.id : '/templates';
  var v = isEdit ? template : {};
  function val(field) { return v[field] != null ? v[field] : ''; }
  function sel(field, option) { return String(val(field)) === String(option) ? 'selected' : ''; }
  function chk(field, option) { return String(val(field)) === String(option) ? 'checked' : ''; }
%>

<div class="page-header">
  <h1><%= isEdit ? 'Edit Template — ' + template.name : 'New Template' %></h1>
  <a href="/templates" class="btn btn-secondary">← Back to Templates</a>
</div>

<form method="POST" action="<%= action %>">
  <div style="display:grid;grid-template-columns:1fr 380px;gap:2rem;max-width:1100px;align-items:start">

    <!-- Left: main form -->
    <div>
      <div class="form-card" style="max-width:none;margin-bottom:1.5rem">
        <h2 style="font-family:'Fraunces',serif;font-size:1rem;font-weight:700;color:var(--navy-800);margin-bottom:1.25rem;padding-bottom:0.5rem;border-bottom:1px solid var(--border)">Template Details</h2>

        <div class="form-group">
          <label>Name *</label>
          <input type="text" name="name" value="<%= val('name') %>" required placeholder="e.g. Stock Update — Nov 2025">
        </div>

        <div class="form-group">
          <label>Channel</label>
          <div style="display:flex;gap:1.5rem;margin-top:0.25rem">
            <% ['EMAIL','WHATSAPP','BOTH'].forEach(function(ch) { %>
              <label style="display:flex;align-items:center;gap:0.4rem;font-weight:400;font-size:0.9rem;cursor:pointer">
                <input type="radio" name="channel" value="<%= ch %>"
                       <%= chk('channel', ch) || (!v.channel && ch === 'EMAIL' ? 'checked' : '') %>
                       onchange="updateSubjectVisibility()">
                <%= ch %>
              </label>
            <% }); %>
          </div>
        </div>

        <div class="form-group">
          <label>Category</label>
          <select name="category">
            <option value="STOCK_UPDATE" <%= sel('category','STOCK_UPDATE') %>>Stock Update</option>
            <option value="QUOTE_FOLLOWUP" <%= sel('category','QUOTE_FOLLOWUP') %>>Quote Follow-up</option>
            <option value="COLD_INTRO" <%= sel('category','COLD_INTRO') %>>Cold Intro</option>
            <option value="FESTIVE" <%= sel('category','FESTIVE') %>>Festive</option>
            <option value="QUALITY_EDUCATION" <%= sel('category','QUALITY_EDUCATION') %>>Quality Education</option>
            <option value="CUSTOM" <%= sel('category','CUSTOM') || (!v.category ? 'selected' : '') %>>Custom</option>
          </select>
        </div>

        <div class="form-group" id="subject-group">
          <label>Subject <span class="text-light" style="font-weight:400">(Email only)</span></label>
          <input type="text" name="subject" value="<%= val('subject') %>" placeholder="e.g. Pune Global Group — Introducing Our Kraft Paper Range">
        </div>

        <div class="form-group">
          <label>Body *</label>
          <textarea name="body" rows="10" required
                    placeholder="Hello {{contact.name}},&#10;&#10;We are pleased to reach out from {{sender.name}}…"><%= val('body') %></textarea>
        </div>

        <div class="form-group">
          <label>Attachment Type</label>
          <select name="attachmentType">
            <option value="NONE" <%= sel('attachmentType','NONE') || (!v.attachmentType ? 'selected' : '') %>>None</option>
            <option value="IMAGE" <%= sel('attachmentType','IMAGE') %>>Image</option>
            <option value="PDF" <%= sel('attachmentType','PDF') %>>PDF</option>
            <option value="QUOTE_PDF" <%= sel('attachmentType','QUOTE_PDF') %>>Quote PDF</option>
          </select>
        </div>

        <div class="form-group">
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer">
            <input type="checkbox" name="isActive" value="on"
                   <%= (isEdit ? (v.isActive ? 'checked' : '') : 'checked') %>>
            <span>Active</span>
          </label>
          <p class="text-light" style="font-size:0.78rem;margin-top:0.25rem">Only active templates appear in campaign creation.</p>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save Changes' : 'Create Template' %></button>
          <% if (isEdit) { %>
            <a href="/templates" class="btn btn-secondary">Cancel</a>
            <form method="POST" action="/templates/<%= template.id %>/delete" style="display:inline;margin-left:auto"
                  onsubmit="return confirm('Delete this template? This cannot be undone.')">
              <button type="submit" class="btn btn-danger">Delete Template</button>
            </form>
          <% } else { %>
            <a href="/templates" class="btn btn-secondary">Cancel</a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Right: variable reference panel -->
    <div>
      <div class="form-card" style="max-width:none;background:var(--bg-warm)">
        <h2 style="font-family:'Fraunces',serif;font-size:0.95rem;font-weight:700;color:var(--navy-800);margin-bottom:1rem;padding-bottom:0.5rem;border-bottom:1px solid var(--border)">Available Variables</h2>
        <p class="text-muted" style="font-size:0.78rem;margin-bottom:1rem">Use these placeholders in your subject and body. They are replaced with real values when the message is sent.</p>

        <div style="display:flex;flex-direction:column;gap:0.5rem">
          <% var vars = [
            ['{{lead.companyName}}', 'Company name'],
            ['{{lead.city}}', 'City'],
            ['{{lead.industry}}', 'Industry'],
            ['{{contact.name}}', 'Contact person name'],
            ['{{contact.designation}}', 'Designation'],
            ['{{quote.quoteNo}}', 'Quote number'],
            ['{{quote.grandTotal}}', 'Quote total (₹)'],
            ['{{quote.validUntil}}', 'Quote validity date'],
            ['{{sender.name}}', 'Pune Global Group'],
            ['{{sender.phone}}', 'Business phone'],
            ['{{today}}', 'Today\'s date'],
          ]; %>
          <% vars.forEach(function(pair) { %>
            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:0.5rem;font-size:0.8rem;padding:0.35rem 0;border-bottom:1px solid var(--border-light)">
              <code style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--saffron);background:var(--saffron-soft);padding:1px 5px;border-radius:3px;white-space:nowrap"><%= pair[0] %></code>
              <span class="text-muted" style="text-align:right"><%= pair[1] %></span>
            </div>
          <% }); %>
        </div>

        <p class="text-light" style="font-size:0.75rem;margin-top:1rem">
          Missing values are replaced with a blank string. Always preview before sending to a live campaign.
        </p>
      </div>
    </div>

  </div>
</form>

<script>
function updateSubjectVisibility() {
  var channel = document.querySelector('input[name="channel"]:checked');
  var subjectGroup = document.getElementById('subject-group');
  if (!channel || !subjectGroup) return;
  if (channel.value === 'WHATSAPP') {
    subjectGroup.style.display = 'none';
  } else {
    subjectGroup.style.display = '';
  }
}
// Run on load
document.addEventListener('DOMContentLoaded', function() {
  updateSubjectVisibility();
  document.querySelectorAll('input[name="channel"]').forEach(function(r) {
    r.addEventListener('change', updateSubjectVisibility);
  });
});
</script>
