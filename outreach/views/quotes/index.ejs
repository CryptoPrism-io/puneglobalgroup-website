<div class="page-header">
  <h1>Quotes</h1>
  <a href="/quotes/new" class="btn btn-primary">+ New Quote</a>
</div>

<form method="GET" action="/quotes" class="filter-bar">
  <select name="status">
    <option value="">All Statuses</option>
    <% ['DRAFT','SENT','ACCEPTED','REJECTED'].forEach(function(s) { %>
      <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>
  <button type="submit" class="btn btn-primary btn-sm">Filter</button>
  <a href="/quotes" class="btn btn-secondary btn-sm">Clear</a>
</form>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Quote No</th>
        <th>Company</th>
        <th>Status</th>
        <th>Items</th>
        <th>Grand Total (₹)</th>
        <th>Valid Until</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (quotes.length === 0) { %>
        <tr>
          <td colspan="8" style="text-align:center;color:var(--text-tertiary);padding:2rem">
            No quotes found. <a href="/quotes/new">Create your first quote.</a>
          </td>
        </tr>
      <% } else { %>
        <% quotes.forEach(function(q) { %>
          <%
            var statusColors = {
              DRAFT:    'background:#e5e7eb;color:#374151',
              SENT:     'background:var(--info-soft);color:var(--info)',
              ACCEPTED: 'background:var(--success-soft);color:var(--success)',
              REJECTED: 'background:var(--error-soft);color:var(--error)',
            };
            var statusStyle = statusColors[q.status] || '';
            var createdDate = new Date(q.createdAt).toLocaleDateString('en-IN');
            var validDate = q.validUntil ? new Date(q.validUntil).toLocaleDateString('en-IN') : '—';
          %>
          <tr>
            <td><a href="/quotes/<%= q.id %>" style="font-weight:600;color:var(--navy-800);font-family:'JetBrains Mono',monospace;font-size:0.85rem"><%= q.quoteNo %></a></td>
            <td><a href="/leads/<%= q.lead.id %>"><%= q.lead.companyName %></a></td>
            <td><span class="badge" style="<%= statusStyle %>"><%= q.status %></span></td>
            <td style="text-align:center"><%= q._count.items %></td>
            <td class="mono" style="font-weight:600">₹<%= parseFloat(q.grandTotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
            <td style="color:var(--text-tertiary);font-size:0.85rem"><%= validDate %></td>
            <td style="color:var(--text-tertiary);font-size:0.85rem"><%= createdDate %></td>
            <td>
              <a href="/quotes/<%= q.id %>" class="btn btn-secondary btn-sm">View</a>
              <% if (q.status === 'DRAFT') { %>
                <a href="/quotes/<%= q.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
              <% } %>
            </td>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table>
</div>

<p class="text-muted" style="margin-top:0.75rem;font-size:0.82rem"><%= quotes.length %> quote<%= quotes.length !== 1 ? 's' : '' %> found</p>
