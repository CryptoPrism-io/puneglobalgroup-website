<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= quote.quoteNo %> — Pune Global Group</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Arial', sans-serif; font-size: 11px; color: #1a1814; background: #fff; }
    .page { max-width: 210mm; margin: 0 auto; }

    /* Header */
    .header { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 16px; border-bottom: 2px solid #0f172a; margin-bottom: 20px; }
    .company-name { font-size: 20px; font-weight: 700; color: #0f172a; letter-spacing: -0.03em; }
    .company-sub { font-size: 10px; color: #6b7280; margin-top: 2px; }
    .quote-title { text-align: right; }
    .quote-title h1 { font-size: 18px; font-weight: 700; color: #0f172a; }
    .quote-no { font-family: 'Courier New', monospace; font-size: 13px; font-weight: 600; color: #d97706; margin-top: 4px; }
    .quote-date { font-size: 10px; color: #6b7280; margin-top: 2px; }

    /* Meta */
    .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
    .meta-box { background: #f7f5f0; border-radius: 6px; padding: 10px 14px; }
    .meta-label { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #8a8279; margin-bottom: 3px; }
    .meta-value { font-size: 11px; font-weight: 600; color: #0f172a; }
    .meta-sub { font-size: 10px; color: #6b7280; }

    /* Table */
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    th { background: #0f172a; color: #fff; font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; padding: 7px 8px; text-align: left; }
    th.right, td.right { text-align: right; }
    th.center, td.center { text-align: center; }
    td { padding: 7px 8px; font-size: 10px; border-bottom: 1px solid #e4dfd6; vertical-align: top; }
    tr:nth-child(even) td { background: #fdfcfa; }
    .product-name { font-weight: 600; font-size: 10px; }
    .product-sub { font-size: 9px; color: #8a8279; margin-top: 1px; }
    .mono { font-family: 'Courier New', monospace; }

    /* Totals */
    .totals-section { display: flex; justify-content: flex-end; margin-bottom: 20px; }
    .totals-box { background: #0f172a; color: #fff; border-radius: 8px; padding: 14px 18px; min-width: 260px; }
    .totals-row { display: flex; justify-content: space-between; font-size: 11px; padding: 3px 0; }
    .totals-row.grand { font-size: 14px; font-weight: 700; border-top: 1px solid rgba(255,255,255,0.2); margin-top: 6px; padding-top: 8px; }

    /* Terms */
    .terms-section { margin-bottom: 16px; }
    .section-title { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #8a8279; margin-bottom: 6px; }
    .terms-text { font-size: 10px; color: #5c574e; line-height: 1.6; white-space: pre-wrap; }

    /* Footer */
    .footer { border-top: 1px solid #e4dfd6; padding-top: 10px; display: flex; justify-content: space-between; font-size: 9px; color: #8a8279; }
    .status-badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 700; }
    .status-draft    { background: #e5e7eb; color: #374151; }
    .status-sent     { background: #dbeafe; color: #1d4ed8; }
    .status-accepted { background: #d1fae5; color: #065f46; }
    .status-rejected { background: #fee2e2; color: #991b1b; }
  </style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header">
    <div>
      <div class="company-name">Pune Global Group</div>
      <div class="company-sub">Industrial Packaging Solutions</div>
      <div class="company-sub" style="margin-top:4px">Pune, Maharashtra · GSTIN: 27XXXXXXXXXXXXX</div>
    </div>
    <div class="quote-title">
      <h1>QUOTATION</h1>
      <div class="quote-no"><%= quote.quoteNo %></div>
      <div class="quote-date">Date: <%= new Date(quote.createdAt).toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' }) %></div>
      <div style="margin-top:4px">
        <span class="status-badge status-<%= quote.status.toLowerCase() %>"><%= quote.status %></span>
      </div>
    </div>
  </div>

  <!-- Meta -->
  <div class="meta-grid">
    <div class="meta-box">
      <div class="meta-label">Bill To</div>
      <div class="meta-value"><%= quote.lead.companyName %></div>
      <% if (quote.lead.city || quote.lead.state) { %>
        <div class="meta-sub"><%= [quote.lead.city, quote.lead.state].filter(Boolean).join(', ') %></div>
      <% } %>
      <% if (quote.lead.gstin) { %>
        <div class="meta-sub">GSTIN: <%= quote.lead.gstin %></div>
      <% } %>
      <% if (quote.contact) { %>
        <div class="meta-sub" style="margin-top:4px">Attn: <%= quote.contact.name %></div>
      <% } %>
    </div>
    <div class="meta-box">
      <div class="meta-label">Quote Details</div>
      <div class="meta-value">Quote No: <%= quote.quoteNo %></div>
      <div class="meta-sub">GST Type: <%= quote.gstType === 'CGST_SGST' ? 'Intra-state (CGST + SGST)' : 'Inter-state (IGST)' %></div>
      <% if (quote.validUntil) { %>
        <div class="meta-sub">Valid Until: <%= new Date(quote.validUntil).toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' }) %></div>
      <% } %>
    </div>
  </div>

  <!-- Items table -->
  <table>
    <thead>
      <tr>
        <th style="width:25px">#</th>
        <th>Description</th>
        <th class="center" style="width:55px">Qty</th>
        <th class="right" style="width:80px">Unit Price</th>
        <th class="right" style="width:75px">Taxable Amt</th>
        <th class="center" style="width:40px">GST%</th>
        <% if (quote.gstType === 'CGST_SGST') { %>
          <th class="right" style="width:65px">CGST</th>
          <th class="right" style="width:65px">SGST</th>
        <% } else { %>
          <th class="right" style="width:65px">IGST</th>
        <% } %>
        <th class="right" style="width:80px">Line Total</th>
      </tr>
    </thead>
    <tbody>
      <% quote.items.forEach(function(item, idx) { %>
        <tr>
          <td class="center" style="color:#8a8279"><%= idx + 1 %></td>
          <td>
            <div class="product-name"><%= item.productName %></div>
            <div class="product-sub">
              <%= item.productType %>
              <% if (item.length || item.breadth || item.height) { %>
                · <%= [item.length, item.breadth, item.height].filter(Boolean).join('×') %> mm
              <% } %>
              <% if (item.sheetThickness) { %> · <%= item.sheetThickness %><% } %>
              <% if (item.grade) { %> · Grade: <%= item.grade %><% } %>
            </div>
            <% if (item.remarks) { %>
              <div class="product-sub" style="color:#d97706;font-style:italic">Note: <%= item.remarks %></div>
            <% } %>
          </td>
          <td class="center mono"><%= parseFloat(item.qty).toFixed(0) %></td>
          <td class="right mono">₹<%= parseFloat(item.sellingPrice).toFixed(2) %></td>
          <td class="right mono">₹<%= parseFloat(item.taxableAmt).toFixed(2) %></td>
          <td class="center mono"><%= parseFloat(item.gstRate).toFixed(0) %>%</td>
          <% if (quote.gstType === 'CGST_SGST') { %>
            <td class="right mono">₹<%= parseFloat(item.cgst).toFixed(2) %></td>
            <td class="right mono">₹<%= parseFloat(item.sgst).toFixed(2) %></td>
          <% } else { %>
            <td class="right mono">₹<%= parseFloat(item.igst).toFixed(2) %></td>
          <% } %>
          <td class="right mono" style="font-weight:700">₹<%= parseFloat(item.lineTotal).toFixed(2) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <!-- Totals -->
  <div class="totals-section">
    <div class="totals-box">
      <div class="totals-row">
        <span>Subtotal (Taxable)</span>
        <span class="mono">₹<%= parseFloat(quote.subtotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
      </div>
      <% if (quote.gstType === 'CGST_SGST') { %>
        <div class="totals-row">
          <span>CGST</span>
          <span class="mono">₹<%= parseFloat(quote.totalCgst).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
        </div>
        <div class="totals-row">
          <span>SGST</span>
          <span class="mono">₹<%= parseFloat(quote.totalSgst).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
        </div>
      <% } else { %>
        <div class="totals-row">
          <span>IGST</span>
          <span class="mono">₹<%= parseFloat(quote.totalIgst).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
        </div>
      <% } %>
      <div class="totals-row">
        <span>Total GST</span>
        <span class="mono">₹<%= parseFloat(quote.totalGst).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
      </div>
      <div class="totals-row grand">
        <span>Grand Total</span>
        <span class="mono">₹<%= parseFloat(quote.grandTotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
      </div>
    </div>
  </div>

  <!-- Terms -->
  <% if (quote.terms) { %>
    <div class="terms-section">
      <div class="section-title">Terms &amp; Conditions</div>
      <div class="terms-text"><%= quote.terms %></div>
    </div>
  <% } %>

  <!-- Footer -->
  <div class="footer">
    <span>Pune Global Group · puneglobalgroup.in</span>
    <span>This is a computer-generated quotation.</span>
    <span><%= quote.quoteNo %></span>
  </div>

</div>
</body>
</html>
