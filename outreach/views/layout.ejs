<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>PGG Outreach</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <span class="brand-icon">PGG</span>
      <span class="brand-text">Outreach</span>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section">
        <a href="/" class="nav-item <%= currentPath === '/' ? 'active' : '' %>">
          <span class="nav-icon">◉</span> Dashboard
        </a>
      </div>
      <div class="nav-section-label">CRM</div>
      <div class="nav-section">
        <a href="/leads" class="nav-item <%= currentPath.startsWith('/leads') ? 'active' : '' %>">
          <span class="nav-icon">◎</span> Leads
        </a>
        <a href="/contacts" class="nav-item <%= currentPath.startsWith('/contacts') ? 'active' : '' %>">
          <span class="nav-icon">◉</span> Contacts
        </a>
      </div>
      <div class="nav-section-label">Sales</div>
      <div class="nav-section">
        <a href="/quotes" class="nav-item <%= currentPath.startsWith('/quotes') ? 'active' : '' %>">
          <span class="nav-icon">◉</span> Quotes
        </a>
        <a href="/rfqs" class="nav-item <%= currentPath.startsWith('/rfqs') ? 'active' : '' %>">
          <span class="nav-icon">◎</span> RFQs
        </a>
        <a href="/rate-card" class="nav-item <%= currentPath.startsWith('/rate-card') ? 'active' : '' %>">
          <span class="nav-icon">◉</span> Rate Card
        </a>
      </div>
      <div class="nav-section-label">Outreach</div>
      <div class="nav-section">
        <a href="/templates" class="nav-item <%= currentPath.startsWith('/templates') ? 'active' : '' %>">
          <span class="nav-icon">◎</span> Templates
        </a>
        <a href="/campaigns" class="nav-item <%= currentPath.startsWith('/campaigns') ? 'active' : '' %>">
          <span class="nav-icon">◉</span> Campaigns
        </a>
        <a href="/whatsapp/status" class="nav-item <%= currentPath.startsWith('/whatsapp') ? 'active' : '' %>">
          <span class="nav-icon">◎</span> WhatsApp
        </a>
      </div>
      <div class="nav-section-label">Data</div>
      <div class="nav-section">
        <a href="/scrape-batches" class="nav-item <%= currentPath.startsWith('/scrape-batches') ? 'active' : '' %>">
          <span class="nav-icon">◉</span> Scrape Log
        </a>
        <a href="/analytics" class="nav-item <%= currentPath.startsWith('/analytics') ? 'active' : '' %>">
          <span class="nav-icon">◎</span> Analytics
        </a>
      </div>
    </nav>
    <div class="sidebar-footer">
      <span class="text-muted" style="font-size:0.7rem;">Pune Global Group</span>
    </div>
  </aside>

  <main class="main-content">
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="flash flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash flash-error"><%= error %></div>
    <% } %>

    <%- typeof body !== 'undefined' ? body : '' %>
  </main>
</body>
</html>
