<div class="page-header">
  <h1>Scrape Log</h1>
</div>

<p class="text-muted" style="margin-bottom:1.5rem;font-size:0.9rem">
  Scraping sessions are run via Claude Code terminal. Results appear here.
</p>

<% if (batches.length === 0) { %>
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:2.5rem;text-align:center">
    <p style="color:var(--text-tertiary);font-size:0.95rem">No scrape batches recorded yet.</p>
    <p style="color:var(--text-tertiary);font-size:0.85rem;margin-top:0.5rem">
      Run a scraping session via Claude Code terminal to populate this log.
    </p>
  </div>
<% } else { %>
<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Source</th>
        <th>Query</th>
        <th>Leads Found</th>
        <th>New Leads</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
      <% batches.forEach(function(batch) { %>
      <%
        var dateStr = batch.createdAt
          ? new Date(batch.createdAt).toLocaleDateString('en-IN', {
              day: 'numeric', month: 'short', year: 'numeric',
              hour: '2-digit', minute: '2-digit'
            })
          : '—';
        var sourceLow = (batch.source || '').toLowerCase();
      %>
      <tr>
        <td class="text-mono" style="white-space:nowrap"><%= dateStr %></td>
        <td>
          <% if (batch.source) { %>
            <span class="badge badge-<%= sourceLow %>" style="background:var(--bg-warm);color:var(--text-secondary);border:1px solid var(--border)">
              <%= batch.source %>
            </span>
          <% } else { %>
            <span class="text-light">—</span>
          <% } %>
        </td>
        <td style="max-width:320px;word-break:break-word"><%= batch.query || '—' %></td>
        <td class="text-mono text-right"><%= batch._count ? batch._count.leads : (batch.totalFound || '—') %></td>
        <td class="text-mono text-right"><%= batch.newLeads !== null && batch.newLeads !== undefined ? batch.newLeads : '—' %></td>
        <td style="max-width:260px;word-break:break-word;color:var(--text-secondary)"><%= batch.notes || '—' %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<p class="text-muted" style="margin-top:0.75rem;font-size:0.82rem"><%= batches.length %> batch<%= batches.length !== 1 ? 'es' : '' %> recorded</p>
<% } %>
