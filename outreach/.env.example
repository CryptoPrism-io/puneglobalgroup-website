# Database (Admin — production data)
DATABASE_URL=

# Database (Demo — test/synthetic data, completely isolated)
DATABASE_URL_DEMO=

# Session
SESSION_SECRET=

# Auth — simple username/password (admin and demo users)
ADMIN_PASSWORD=
DEMO_PASSWORD=

# Server
PORT=3001

# Resend (Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=sales@puneglobalgroup.in
RESEND_WEBHOOK_SECRET=

# Sender info
SENDER_NAME=Pune Global Group
SENDER_PHONE=+919XXXXXXXXX

# WAHA (self-hosted WhatsApp transport)
WAHA_URL=http://127.0.0.1:3002
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_DEFAULT_COUNTRY_CODE=91
WHATSAPP_CAMPAIGN_LIMIT=10
WHATSAPP_DAILY_LIMIT=10
WHATSAPP_MIN_DELAY_MS=180000
WHATSAPP_MAX_DELAY_MS=480000
OUTREACH_WINDOW_START=10
OUTREACH_WINDOW_END=18
OUTREACH_WINDOW_DAYS=1,2,3,4,5

# AWS Bedrock (credentials come from the EC2 instance role)
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
BEDROCK_AUTO_REPLY_ENABLED=false
